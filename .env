# ================= AI CHAT APIs =================
GEMINI_API_KEY=.......................
GROQ_API_KEY=...................

# ================= IMAGE GENERATION =================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional (no-key free image fallback)
